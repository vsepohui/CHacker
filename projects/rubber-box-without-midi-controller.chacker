sub config {{no_midi => 1}}

sub synth {
	my $chacker = shift;

	state $i = 0;
	state $streamed = 0;

	my $elapsed = $chacker->offset;
	return if ($streamed > $elapsed + 0.01);

	my $s1 = e (7,42, $i++, sub{sin $_[0]*$_[1]});

	push @{$chacker->{buffer}}, sine(
		int ($s1*100) % 36, 
		0.01,
	);

	$streamed += 0.01;

	$chacker->push_output();
}
