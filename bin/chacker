#!/usr/bin/perl

use 5.022;
use warnings;

use FindBin qw($Bin);
use lib "$Bin/../lib";

use Time::HiRes qw(gettimeofday tv_interval);

use CHacker;

my $file = $ARGV[0] or die "Project is not specified";

my $project = '';
my $fi;
open $fi, $file;
$project = join '', <$fi>;
close $fi;
eval "$project";

die $@ if $@;


my $chacker = new CHacker;

$chacker->init_midi();
$chacker->map_midi();


my $cv = AnyEvent->condvar;

$chacker->init_output;


my $idle = AnyEvent->idle(cb => sub { synth ($chacker) } );

$cv->recv;

1;
