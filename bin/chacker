#!/usr/bin/perl

use 5.022;
use warnings;

use FindBin qw($Bin);
use lib "$Bin/../lib";

use Time::HiRes qw(gettimeofday tv_interval);

use CHacker;


my $usage = "Usage:\n\t$0 [--help|-h] [--input|-i=file.hacker] [project-file.chacker]";
my %args = process_command_line(qw/i|input=s h|help v|version/, $usage);

if ($args{version}) {
	say "CHacker 0.1a";
	exit;
}

my $stdin = ($ARGV[-1] // '') ;
my $file = $args{input} // $ARGV[-1];

say $usage and exit() unless -f $file;

my $project = '';
my $fi;
open $fi, $file;
$project = join '', <$fi>;
close $fi;
eval "$project";

die $@ if $@;

my $config = eval "config()" || {};

my $chacker = new CHacker;

if (!$config->{no_midi}) {
	$chacker->init_midi();
	$chacker->map_midi();
}


my $cv = AnyEvent->condvar;

$chacker->init_output;


my $idle = AnyEvent->idle(cb => sub { synth ($chacker) } );

$cv->recv;

1;
